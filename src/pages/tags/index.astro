---
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { SITE } from "@/config";

import type { FirestorePostMapped } from "@/utils/firebasePosts";
import { getAllPosts } from "@/utils/firebasePosts";

const posts: FirestorePostMapped[] = await getAllPosts();

// Build the same structure that getUniqueTags() returns
const tags = Array.from(
  new Set(posts.flatMap((p) => p.data.tags))
).map((tag) => ({
  tag,
  tagName: tag,
}));
---

<Layout title={`Tags | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Tags" pageDesc="All the tags used in posts.">
    <ul>
      {tags.map(({ tag, tagName }) => (
        <Tag {tag} {tagName} size="lg" />
      ))}
    </ul>
  </Main>
  <Footer />
</Layout>
