---
import type { GetStaticPathsOptions, PaginateFunction } from "astro";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { SITE } from "@/config";

import type { FirestorePostMapped } from "@/utils/firebasePosts";
import { getAllPosts } from "@/utils/firebasePosts";

export async function getStaticPaths(
  { paginate }: GetStaticPathsOptions & { paginate: PaginateFunction }
) {
  const posts: FirestorePostMapped[] = await getAllPosts();

  // Extract all unique tags
  const tags = Array.from(
    new Set(posts.flatMap((post) => post.data.tags))
  ).map((tag) => ({
    tag,
    tagName: tag,
  }));

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = posts.filter((post: FirestorePostMapped) =>
      post.data.tags.includes(tag)
    );

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;
---

<Layout title={`Tag: ${tagName} | ${SITE.title}`}>
  <Header />

  <Main
    pageTitle={[`Tag:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`All the articles with the tag "${tagName}".`}
  >
    <h1 slot="title" transition:name={tag}>{`Tag:${tag}`}</h1>

    <ul>
      {page.data.map((post: FirestorePostMapped) => <Card {...post} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
