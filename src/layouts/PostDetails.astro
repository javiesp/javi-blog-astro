---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import { slugifyStr } from "@/utils/slugify";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";

export interface Props {
  post: any; // FirestorePostMapped
  posts: any[];
}

const { post, posts } = Astro.props;
const { title, body, data } = post;
const { author, description, pubDatetime, modDatetime, timezone, tags } = data;
---

<Layout title={title} author={author} description={description}>
  <Header />
  <BackButton />

  <main class="mx-auto max-w-app px-4 pb-12">
    <h1 class="text-3xl font-bold">{title}</h1>
    <div class="my-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} />
    </div>

    <!-- Display Markdown as raw string -->
    <article class="app-prose mt-8">
      <pre>{body}</pre>
    </article>

    <ul class="mt-4">
      {tags.map((tag: string) => <Tag tag={slugifyStr(tag)} tagName={tag} />)}
    </ul>    

    <BackToTopButton />
  </main>

  <Footer />
</Layout>
